# ─────────────────────────────────────────────────────────────
# L’Art du Pain — variables d’environnement
# Copiez ce fichier en .env.local (développement) ou saisissez-les dans Vercel → Settings → Environment Variables.
# AUCUNE de ces valeurs ne doit être commitée ni exposée au navigateur.
# ─────────────────────────────────────────────────────────────

# URL publique du site (liens des emails, retours Stripe)
SITE_URL=https://www.lartdupain-nogent.fr
NEXT_PUBLIC_SITE_URL=https://www.lartdupain-nogent.fr

# Base de données PostgreSQL (Supabase → Project Settings → Database → Connection string, mode "Transaction pooler")
# Laisser vide en local : une base PGlite est créée automatiquement dans .data/pglite
DATABASE_URL=

# Secret de signature des sessions admin (32 caractères minimum) — ex. : openssl rand -base64 48
AUTH_SECRET=

# Premier compte super administrateur, créé au premier `npm run db:migrate`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Stripe (CB, Apple Pay, Google Pay) — dashboard.stripe.com → Developers
STRIPE_SECRET_KEY=
# Webhook : https://<domaine>/api/stripe/webhook — événements checkout.session.completed, checkout.session.expired, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# Emails transactionnels (resend.com) — domaine d’envoi à vérifier chez Resend
RESEND_API_KEY=
EMAIL_FROM=L’Art du Pain <commandes@lartdupain-nogent.fr>
# Alerte équipe (modifiable aussi dans /admin/parametres)
STAFF_EMAIL=

# Stockage des images (Supabase Storage) : bucket public "media" et bucket privé "private"
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLIC_BUCKET=media
SUPABASE_PRIVATE_BUCKET=private

# SMS / WhatsApp Business : URL d’une fonction qui reçoit { to, text, type } et appelle votre fournisseur (Twilio, Brevo, Meta Cloud API…)
SMS_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=
